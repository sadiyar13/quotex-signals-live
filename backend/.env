# Forex Binary Options Signal Dashboard Environment Settings
# DATA_MODE options: REAL (live market & official interbank feeds), DEMO_OFFLINE (isolated synthetic)
DATA_MODE=REAL

# Optional API Keys:
# Twelve Data provides 800 free calls/day: https://twelvedata.com
# If left empty, system automatically uses authentic Yahoo Finance Interbank Forex Feed (Zero Key Required).
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Strategy Parameters Defaults
EMA_FAST_PERIOD=20
EMA_SLOW_PERIOD=50
RSI_PERIOD=14
RSI_OVERBOUGHT=70.0
RSI_OVERSOLD=30.0
ATR_PERIOD=14
MIN_RULE_AGREEMENT_COUNT=4
DEFAULT_PAYOUT_RATIO=0.85
